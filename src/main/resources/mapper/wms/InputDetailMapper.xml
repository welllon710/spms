<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.spms.wms.mapper.InputDetailMapper">
    <resultMap id="inputDetailResultMap" type="com.spms.wms.entity.InputDetailEntity">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_disabled" property="isDisabled"/>
        <result column="is_published" property="isPublished"/>
        <result column="bill_id" property="billId"/>
        <result column="is_finished" property="isFinished"/>
        <result column="finish_quantity" property="finishQuantity"/>
        <result column="quantity" property="quantity"/>
        <result column="material_id" property="materialId"/>

        <association property="material" javaType="com.spms.asset.entity.MaterialEntity">
            <id column="material_join_id" property="id"/>
            <result column="material_code" property="code"/>
            <result column="material_name" property="name"/>
            <result column="material_spc" property="spc"/>
            <result column="material_type" property="materialType"/>
            <result column="material_use_type" property="useType"/>
            <result column="material_unit_id" property="unitId"/>
            <result column="material_purchase_price" property="purchasePrice"/>
            <result column="material_sale_price" property="salePrice"/>

            <association property="unit" javaType="com.spms.personal.entity.UnitEntity">
                <id column="unit_join_id" property="id"/>
                <result column="unit_name" property="name"/>
                <result column="unit_code" property="code"/>
            </association>
        </association>
    </resultMap>

    <sql id="inputDetailColumns">
        idt.id,
        idt.create_time,
        idt.update_time,
        idt.is_disabled,
        idt.is_published,
        idt.bill_id,
        idt.is_finished,
        idt.finish_quantity,
        idt.quantity,
        idt.material_id,
        m.id as material_join_id,
        m.code as material_code,
        m.name as material_name,
        m.spc as material_spc,
        m.material_type,
        m.use_type as material_use_type,
        m.unit_id as material_unit_id,
        m.purchase_price as material_purchase_price,
        m.sale_price as material_sale_price,
        u.id as unit_join_id,
        u.name as unit_name,
        u.code as unit_code
    </sql>

    <sql id="inputDetailJoinFrom">
        from input_detail idt
        left join material m on m.id = idt.material_id
        left join `unit` u on u.id = m.unit_id
    </sql>

    <select id="getByBillId" resultMap="inputDetailResultMap">
        select
        <include refid="inputDetailColumns"/>
        <include refid="inputDetailJoinFrom"/>
        where idt.bill_id = #{billId}
        order by idt.id asc
    </select>
</mapper>
