<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.spms.personal.mapper.MenuMapper">
    <resultMap id="menuResultMap" type="com.spms.personal.entity.MenuEntity">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_disabled" property="isDisabled"/>
        <result column="is_published" property="isPublished"/>
        <result column="name" property="name"/>
        <result column="parent_id" property="parentId"/>
        <result column="path" property="path"/>
        <result column="component" property="component"/>
        <result column="icon" property="icon"/>
        <result column="order_no" property="orderNo"/>
    </resultMap>

    <sql id="menuColumns">
        id,
        create_time,
        update_time,
        is_disabled,
        is_published,
        name,
        parent_id,
        path,
        component,
        icon,
        order_no
    </sql>

    <select id="getPageList" resultMap="menuResultMap">
        select
        <include refid="menuColumns"/>
        from menu
        <where>
            <if test="name != null and name != ''">
                and name like concat('%', #{name}, '%')
            </if>
            <if test="parentId != null">
                and parent_id = #{parentId}
            </if>
            <if test="path != null and path != ''">
                and path like concat('%', #{path}, '%')
            </if>
            <if test="component != null and component != ''">
                and component like concat('%', #{component}, '%')
            </if>
            <if test="isDisabled != null">
                and is_disabled = #{isDisabled}
            </if>
        </where>
        order by order_no desc
    </select>

    <select id="getById" resultMap="menuResultMap">
        select
        <include refid="menuColumns"/>
        from menu
        where id = #{id}
        limit 1
    </select>

    <select id="countByName" resultType="int">
        select count(1)
        from menu
        where name = #{name}
        <if test="excludeId != null">
            and id != #{excludeId}
        </if>
    </select>

    <select id="countByParentId" resultType="int">
        select count(1)
        from menu
        where parent_id = #{parentId}
    </select>

    <select id="countRoleMenuByMenuId" resultType="int">
        select count(1)
        from role_menu_list
        where menu_list_id = #{menuId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into menu (
            create_time,
            update_time,
            is_disabled,
            is_published,
            name,
            parent_id,
            path,
            component,
            icon,
            order_no
        )
        values (
            #{createTime},
            #{updateTime},
            #{isDisabled},
            #{isPublished},
            #{name},
            #{parentId},
            #{path},
            #{component},
            #{icon},
            #{orderNo}
        )
    </insert>

    <update id="update">
        update menu
        set update_time = #{updateTime},
            is_disabled = #{isDisabled},
            name = #{name},
            parent_id = #{parentId},
            path = #{path},
            component = #{component},
            icon = #{icon},
            order_no = #{orderNo}
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from menu
        where id = #{id}
    </delete>
</mapper>
